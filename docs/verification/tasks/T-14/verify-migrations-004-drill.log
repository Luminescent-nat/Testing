CREATE TABLE alembic_version (
    version_num VARCHAR(32) NOT NULL, 
    CONSTRAINT alembic_version_pkc PRIMARY KEY (version_num)
);

-- Running upgrade  -> 0817df993d8b

CREATE TABLE users (
    id INTEGER NOT NULL, 
    username VARCHAR(50) NOT NULL, 
    password_hash VARCHAR(255) NOT NULL, 
    role VARCHAR(20) NOT NULL, 
    status VARCHAR(20) NOT NULL, 
    pc_identifier VARCHAR(255), 
    last_login_at DATETIME, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME, 
    PRIMARY KEY (id)
);

CREATE INDEX ix_users_id ON users (id);

CREATE UNIQUE INDEX ix_users_username ON users (username);

CREATE TABLE devices (
    id INTEGER NOT NULL, 
    serial_number VARCHAR(100) NOT NULL, 
    model VARCHAR(100), 
    brand VARCHAR(50), 
    android_version VARCHAR(20), 
    sdk_version VARCHAR(10), 
    cpu_abi VARCHAR(50), 
    resolution VARCHAR(20), 
    battery_level INTEGER, 
    status VARCHAR(20) NOT NULL, 
    owner_id INTEGER, 
    pc_identifier VARCHAR(255) NOT NULL, 
    last_seen_at DATETIME, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME, 
    board VARCHAR(50), 
    hardware VARCHAR(50), 
    ddr_info JSON, 
    emmc_info JSON, 
    wifi_chip VARCHAR(100), 
    bt_chip VARCHAR(100), 
    eth_interfaces JSON, 
    features JSON, 
    PRIMARY KEY (id), 
    FOREIGN KEY(owner_id) REFERENCES users (id)
);

CREATE INDEX ix_devices_id ON devices (id);

CREATE UNIQUE INDEX ix_devices_serial_number ON devices (serial_number);

CREATE TABLE failure_patterns (
    id INTEGER NOT NULL, 
    name VARCHAR(100) NOT NULL, 
    category VARCHAR(50), 
    pattern VARCHAR(500) NOT NULL, 
    description TEXT, 
    suggested_fix TEXT, 
    occurrence_count INTEGER, 
    created_by INTEGER, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME, 
    PRIMARY KEY (id), 
    FOREIGN KEY(created_by) REFERENCES users (id)
);

CREATE INDEX ix_failure_patterns_id ON failure_patterns (id);

CREATE TABLE knowledge_entries (
    id INTEGER NOT NULL, 
    title VARCHAR(200) NOT NULL, 
    entry_type VARCHAR(50) NOT NULL, 
    category VARCHAR(100), 
    tags JSON, 
    content TEXT, 
    chunks JSON, 
    embedding JSON, 
    source_type VARCHAR(50) NOT NULL, 
    source_file VARCHAR(500), 
    status VARCHAR(50) NOT NULL, 
    metadata JSON, 
    pass_count INTEGER, 
    fail_count INTEGER, 
    hit_count INTEGER, 
    created_by INTEGER, 
    created_at DATETIME, 
    updated_at DATETIME, 
    PRIMARY KEY (id), 
    FOREIGN KEY(created_by) REFERENCES users (id)
);

CREATE INDEX ix_knowledge_entries_id ON knowledge_entries (id);

CREATE TABLE test_modules (
    id INTEGER NOT NULL, 
    name VARCHAR(100) NOT NULL, 
    category VARCHAR(50), 
    description TEXT, 
    icon VARCHAR(50), 
    sort_order INTEGER, 
    enabled BOOLEAN, 
    created_by INTEGER, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME, 
    PRIMARY KEY (id), 
    FOREIGN KEY(created_by) REFERENCES users (id)
);

CREATE INDEX ix_test_modules_id ON test_modules (id);

CREATE TABLE test_tools (
    id INTEGER NOT NULL, 
    name VARCHAR(100) NOT NULL, 
    description TEXT, 
    filename VARCHAR(255) NOT NULL, 
    version VARCHAR(50), 
    architecture VARCHAR(50), 
    file_size INTEGER NOT NULL, 
    file_path VARCHAR(500) NOT NULL, 
    mime_type VARCHAR(100), 
    md5_hash VARCHAR(32), 
    created_by INTEGER, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME, 
    PRIMARY KEY (id), 
    FOREIGN KEY(created_by) REFERENCES users (id)
);

CREATE INDEX ix_test_tools_id ON test_tools (id);

CREATE TABLE test_items (
    id INTEGER NOT NULL, 
    module_id INTEGER NOT NULL, 
    name VARCHAR(100) NOT NULL, 
    description TEXT, 
    objective TEXT, 
    precondition TEXT, 
    steps TEXT, 
    expected_result TEXT, 
    sort_order INTEGER, 
    enabled BOOLEAN, 
    exec_type VARCHAR(20) NOT NULL, 
    exec_command TEXT NOT NULL, 
    tool_id INTEGER, 
    push_target VARCHAR(255), 
    parameters JSON, 
    parameters_schema JSON, 
    compatibility JSON, 
    judgement_type VARCHAR(20), 
    conditional_rules JSON, 
    rubric_criteria JSON, 
    result_parse JSON, 
    timeout INTEGER, 
    on_failure VARCHAR(20), 
    retry_count INTEGER, 
    skills JSON, 
    tags JSON, 
    created_by INTEGER, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME, 
    PRIMARY KEY (id), 
    FOREIGN KEY(created_by) REFERENCES users (id), 
    FOREIGN KEY(module_id) REFERENCES test_modules (id), 
    FOREIGN KEY(tool_id) REFERENCES test_tools (id)
);

CREATE INDEX ix_test_items_id ON test_items (id);

CREATE TABLE test_tasks (
    id INTEGER NOT NULL, 
    user_id INTEGER NOT NULL, 
    device_id INTEGER NOT NULL, 
    name VARCHAR(200), 
    selected_items JSON NOT NULL, 
    custom_parameters JSON, 
    status VARCHAR(20) NOT NULL, 
    progress_percent INTEGER, 
    "plan" JSON, 
    report_path VARCHAR(500), 
    error_message TEXT, 
    schedule_type VARCHAR(20) NOT NULL, 
    scheduled_time VARCHAR(50), 
    next_run_at DATETIME, 
    started_at DATETIME, 
    completed_at DATETIME, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    PRIMARY KEY (id), 
    FOREIGN KEY(device_id) REFERENCES devices (id), 
    FOREIGN KEY(user_id) REFERENCES users (id)
);

CREATE INDEX ix_test_tasks_id ON test_tasks (id);

CREATE TABLE golden_cases (
    id INTEGER NOT NULL, 
    item_id INTEGER NOT NULL, 
    device_model VARCHAR(100) NOT NULL, 
    expected_status VARCHAR(20) NOT NULL, 
    expected_output_pattern VARCHAR(500), 
    sample_output TEXT, 
    pass_count INTEGER, 
    total_count INTEGER, 
    is_active BOOLEAN, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    updated_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    PRIMARY KEY (id), 
    FOREIGN KEY(item_id) REFERENCES test_items (id)
);

CREATE INDEX ix_golden_cases_device_model ON golden_cases (device_model);

CREATE INDEX ix_golden_cases_id ON golden_cases (id);

CREATE TABLE test_records (
    id INTEGER NOT NULL, 
    task_id INTEGER NOT NULL, 
    item_id INTEGER NOT NULL, 
    status VARCHAR(20) NOT NULL, 
    output TEXT, 
    fail_reason TEXT, 
    extracted_data JSON, 
    execution_time INTEGER, 
    log_file_path VARCHAR(500), 
    started_at DATETIME, 
    completed_at DATETIME, 
    created_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    PRIMARY KEY (id), 
    FOREIGN KEY(item_id) REFERENCES test_items (id), 
    FOREIGN KEY(task_id) REFERENCES test_tasks (id)
);

CREATE INDEX ix_test_records_id ON test_records (id);

CREATE TABLE baselines (
    id INTEGER NOT NULL, 
    device_model VARCHAR(100) NOT NULL, 
    item_id INTEGER NOT NULL, 
    metric_name VARCHAR(100) NOT NULL, 
    avg_value VARCHAR(50), 
    min_value VARCHAR(50), 
    max_value VARCHAR(50), 
    sample_count INTEGER, 
    last_record_id INTEGER, 
    updated_at DATETIME DEFAULT (CURRENT_TIMESTAMP), 
    PRIMARY KEY (id), 
    FOREIGN KEY(item_id) REFERENCES test_items (id), 
    FOREIGN KEY(last_record_id) REFERENCES test_records (id)
);

CREATE INDEX ix_baselines_device_model ON baselines (device_model);

CREATE INDEX ix_baselines_id ON baselines (id);

INSERT INTO alembic_version (version_num) VALUES ('0817df993d8b') RETURNING version_num;

