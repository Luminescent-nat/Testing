# 测试平台环境配置（复制为 .env 后按需修改；.env 已被 .gitignore 忽略）

# 【必填】JWT 签名密钥；应用启动时做强度校验，以下情况一律拒绝启动：
#   - 空/纯空白
#   - 长度不足 32 字符
#   - Compose/文档示例占位值（secret、change-me、your-secret-key、
#     please-change-* 系列等）及其变体
#   - 单字符重复
# 生成随机密钥：python -c "import secrets; print('SECRET_KEY=' + secrets.token_urlsafe(48))"
SECRET_KEY=

# 开放注册开关：false 时仅首个用户可注册（自动成为 admin），后续账号由 admin 创建
REGISTRATION_ENABLED=false

# CORS 允许源（逗号分隔）。前后端同源部署留空即可；仅独立前端服务器场景需要配置
ALLOWED_ORIGINS=

# 数据库配置（默认 SQLite，免安装开箱即用）
DATABASE_URL=sqlite+aiosqlite:///./test_platform.db

# 测试工具根目录（host_exec 类测试项的 {host_tool_dir} 默认解析位置）
TEST_TOOLS_PATH=../test-tools

# 开发模式（true 时全局异常会返回详细错误信息，生产环境保持 false）
DEBUG=false
