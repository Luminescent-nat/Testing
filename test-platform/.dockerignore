# 构建上下文 = test-platform/ 根目录
.git

# Python
**/__pycache__
**/*.pyc
**/*.pyo

# Node（前端依赖在镜像内 npm ci，dist 在镜像内重新构建）
**/node_modules
frontend/dist
frontend/test-results

# 测试与本地数据不进镜像
backend/tests
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
*.log

# 运行时数据目录（由 volume 挂载，而非打进镜像）
data/
backups/
storage/
backend/storage/

# test-tools 必须进镜像（T-17：manifest + runner + 各架构二进制）；
# 仅排除其 __pycache__/*.pyc（上面的全局规则已覆盖）。

# 部署相关文件本身无需进镜像
Dockerfile
docker-compose.yml
.dockerignore
DEPLOYMENT.md
scripts/
